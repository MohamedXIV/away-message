# Copy this file to .env.local and fill your keys — .env.local is git-ignored and never pushed.
# VITE_* values are bundled into the browser build at build time.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-20b
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/free
VITE_FAL_API_KEY=
VITE_FAL_MODEL=fal-ai/flux/schnell
